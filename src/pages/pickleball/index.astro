---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('pickleball', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });
---

<Base title="Pickleball" description="Pickleball games, clips, and notes from Jerry Zhang.">
  <h1 class="font-display text-[clamp(2.75rem,7vw,4.5rem)] font-bold tracking-[-0.04em]">Pickleball</h1>
  <p class="mt-4 max-w-[38rem] text-muted">Games, clips, and notes from the court.</p>

  {posts.length > 0 ? (
    <ul class="mt-14 border-t border-line">
      {posts.map((post) => (
        <li class="grid gap-x-12 gap-y-2 border-b border-line py-7 md:grid-cols-[11rem_1fr]">
          <time class="font-display text-sm text-muted tabular-nums md:pt-1.5" datetime={post.data.date.toISOString()}>
            {fmt(post.data.date)}
          </time>
          <div class="max-w-[38rem]">
            {post.data.image && (
              <a href={`/pickleball/${post.id}/`} class="mb-4 block">
                <img src={post.data.image} alt="" class="aspect-[16/9] w-full rounded-lg object-cover" loading="lazy" />
              </a>
            )}
            <a href={`/pickleball/${post.id}/`} class="font-display text-2xl font-semibold text-ink no-underline hover:text-accent">
              {post.data.title}
            </a>
            {post.data.description && <p class="mt-1 text-base text-muted">{post.data.description}</p>}
          </div>
        </li>
      ))}
    </ul>
  ) : (
    <p class="mt-14 border-t border-line pt-8 text-muted">Nothing posted yet.</p>
  )}
</Base>
