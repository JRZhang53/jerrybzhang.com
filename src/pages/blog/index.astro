---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });
---

<Base title="Blog" description="Writing by Jerry Zhang.">
  <h1>Blog</h1>
  <p class="muted">Notes on things I'm building, learning, and thinking about.</p>

  <ul class="posts">
    {posts.map((post) => (
      <li>
        <a href={`/blog/${post.id}/`} class="title">{post.data.title}</a>
        <time class="muted" datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time>
        <p class="muted">{post.data.description}</p>
      </li>
    ))}
  </ul>
</Base>

<style>
  .posts {
    list-style: none;
    padding: 0;
    margin: 2rem 0 0;
  }
  .posts li {
    display: grid;
    grid-template-columns: 1fr auto;
    column-gap: 1rem;
    padding: 1rem 0;
    border-bottom: 1px solid var(--border);
  }
  .title {
    font-family: 'Newsreader', Georgia, serif;
    font-size: 1.25rem;
    color: var(--fg);
    text-decoration: none;
  }
  .title:hover {
    color: var(--accent);
  }
  time {
    font-size: 0.9rem;
    white-space: nowrap;
  }
  .posts p {
    grid-column: 1 / -1;
    margin: 0.25rem 0 0;
    font-size: 0.95rem;
  }
</style>
