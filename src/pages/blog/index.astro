---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });
---

<Base title="Writing" description="Writing by Jerry Zhang.">
  <h1 class="font-display text-[clamp(2.75rem,7vw,4.5rem)] font-bold tracking-[-0.04em]">Writing</h1>
  <p class="mt-4 max-w-[38rem] text-muted">Notes on things I'm building, learning, and thinking about.</p>

  <ul class="mt-14 border-t border-line">
    {posts.map((post) => (
      <li class="grid gap-x-12 gap-y-1 border-b border-line py-7 md:grid-cols-[11rem_1fr]">
        <time class="font-display text-sm text-muted tabular-nums md:pt-1.5" datetime={post.data.date.toISOString()}>
          {fmt(post.data.date)}
        </time>
        <div class="max-w-[38rem]">
          <a href={`/blog/${post.id}/`} class="font-display text-2xl font-semibold text-ink no-underline hover:text-accent">
            {post.data.title}
          </a>
          <p class="mt-1 text-base text-muted">{post.data.description}</p>
        </div>
      </li>
    ))}
  </ul>
</Base>
