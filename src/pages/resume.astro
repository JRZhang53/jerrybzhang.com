---
import Base from '../layouts/Base.astro';
import fs from 'node:fs';
import { EDUCATION, EXPERIENCE, RESEARCH } from '../data/resume';
import { PROJECTS } from '../data/projects';

// Drop your resume at public/resume.pdf and it replaces the summary below.
const hasPdf = fs.existsSync(new URL('../../public/resume.pdf', import.meta.url));
const positions = [
  { heading: 'Experience', items: EXPERIENCE },
  { heading: 'Research', items: RESEARCH },
];
const projects = PROJECTS.filter((p) => p.kind === 'course');
---

<Base title="Resume" description="Education, experience, research, and projects of Jerry Zhang.">
  <h1 class="font-display text-[clamp(2.75rem,7vw,4.5rem)] font-bold tracking-[-0.04em]">Resume</h1>
  {hasPdf ? (
    <>
      <p class="mt-4 font-display text-base"><a href="/resume.pdf">Download PDF</a></p>
      <object data="/resume.pdf" type="application/pdf" class="mt-8 h-[80vh] min-h-[32rem] w-full rounded-lg border border-line" aria-label="Resume PDF">
        <p>This browser can't show the PDF inline. <a href="/resume.pdf">Download the PDF</a> instead.</p>
      </object>
    </>
  ) : (
    <div class="mt-14 space-y-16">
      <section class="grid gap-x-12 gap-y-4 md:grid-cols-[11rem_1fr]">
        <h2 class="text-2xl md:pt-1">Education</h2>
        <ul class="max-w-[38rem] space-y-3">
          {EDUCATION.map((e) => (
            <li>
              <div class="flex items-baseline justify-between gap-6">
                <span class="font-display text-xl font-semibold">{e.school}</span>
                <span class="shrink-0 font-display text-sm text-muted tabular-nums">{e.years}</span>
              </div>
              {e.details.map((d) => <p class="text-base text-muted">{d}</p>)}
            </li>
          ))}
        </ul>
      </section>

      {positions.map(({ heading, items }) => (
        <section class="grid gap-x-12 gap-y-4 md:grid-cols-[11rem_1fr]">
          <h2 class="text-2xl md:pt-1">{heading}</h2>
          <ul class="max-w-[38rem] space-y-9">
            {items.map((e) => (
              <li>
                <p class="font-display text-xl font-semibold">
                  {e.org}
                  {e.place && <span class="ml-2 font-display text-sm font-normal text-muted">{e.place}</span>}
                </p>
                <ul class="mt-2 space-y-4">
                  {e.roles.map((r) => (
                    <li>
                      <div class="flex items-baseline justify-between gap-6">
                        <span class="italic">{r.title}</span>
                        <span class="shrink-0 font-display text-sm text-muted tabular-nums">{r.years}</span>
                      </div>
                      {r.points && (
                        <ul class="mt-1.5 list-disc space-y-1 pl-5 text-base marker:text-muted">
                          {r.points.map((p) => <li>{p}</li>)}
                        </ul>
                      )}
                    </li>
                  ))}
                </ul>
              </li>
            ))}
          </ul>
        </section>
      ))}

      <section class="grid gap-x-12 gap-y-4 md:grid-cols-[11rem_1fr]">
        <h2 class="text-2xl md:pt-1">Course projects</h2>
        <div class="max-w-[38rem]">
          <ul class="space-y-2">
            {projects.map((p) => (
              <li class="flex items-baseline justify-between gap-6">
                <span>{p.name}</span>
                <span class="shrink-0 font-display text-sm text-muted tabular-nums">{p.year}</span>
              </li>
            ))}
          </ul>
          <p class="mt-4 font-display text-base"><a href="/projects/">Read the project summaries</a></p>
        </div>
      </section>
    </div>
  )}
</Base>
