---
import Base from '../layouts/Base.astro';
import fs from 'node:fs';
import ResumeExplorer from '../components/resume/ResumeExplorer';
const hasPdf = fs.existsSync(new URL('../../public/resume.pdf', import.meta.url));
---

<Base title="Resume" description="Education, experience, and research across time and place. Jerry Zhang's resume.">
  <div class="resume-page">
    <h1 class="font-display text-[clamp(2.75rem,7vw,4.5rem)] font-bold tracking-[-0.04em]">Resume</h1>
    <ResumeExplorer client:load />
    <div class="resume-actions mt-6 flex gap-6 font-display text-sm">
      {hasPdf && <a href="/resume.pdf" class="inline-flex min-h-11 items-center">Download PDF</a>}
      <button type="button" id="print-resume" class="min-h-11 text-muted underline underline-offset-4 hover:text-accent">Print resume</button>
    </div>
  </div>
</Base>

<script>
  document.querySelector('#print-resume')?.addEventListener('click', () => window.print());
  let openedForPrint: HTMLDetailsElement[] = [];
  window.addEventListener('beforeprint', () => {
    openedForPrint = [...document.querySelectorAll<HTMLDetailsElement>('.resume-entry:not([open])')];
    openedForPrint.forEach((details) => { details.open = true; });
  });
  window.addEventListener('afterprint', () => {
    openedForPrint.forEach((details) => { details.open = false; });
    openedForPrint = [];
  });
</script>

<style is:global>
  .resume-page summary { list-style: none; }
  .resume-page summary::-webkit-details-marker { display: none; }
  .resume-page { --gantt-work: #2742e8; --gantt-education: #147d78; --gantt-research: #8750ac; }
  .dark .resume-page { --gantt-work: #93a3ff; --gantt-education: #71c7ba; --gantt-research: #cba3e6; }
  .resume-page [data-category='Experience'] { --gantt-color: var(--gantt-work); }
  .resume-page [data-category='Education'] { --gantt-color: var(--gantt-education); }
  .resume-page [data-category='Research'] { --gantt-color: var(--gantt-research); }
  .gantt-legend > span { display: inline-flex; align-items: center; gap: 0.5rem; }
  .gantt-legend i { width: 0.65rem; height: 0.65rem; border-radius: 2px; background: var(--gantt-color); }
  .gantt-scroll { overflow-x: auto; scrollbar-width: thin; scrollbar-color: var(--color-line) transparent; }
  .gantt-chart { min-width: 720px; }
  .timeline-grid { display: grid; grid-template-columns: 28% minmax(0, 1fr); align-items: stretch; }
  .timeline-axis { padding-bottom: 0.75rem; }
  .gantt-label { position: sticky; left: 0; z-index: 1; display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; padding-right: 1.25rem; background: var(--color-paper); }
  .resume-entry summary { min-height: 48px; }
  .resume-entry summary .gantt-label { padding-top: 0.65rem; padding-bottom: 0.65rem; }
  .gantt-track { position: relative; background: repeating-linear-gradient(to right, var(--color-line) 0 1px, transparent 1px calc(100% / 9)); }
  .gantt-bar { position: absolute; top: 50%; height: 12px; border-radius: 2px; transform: translateY(-50%); background: var(--gantt-color); opacity: 0.8; transition: opacity 150ms ease-out; }
  .gantt-upcoming { position: absolute; right: 0.5rem; top: 50%; transform: translateY(-50%); color: var(--gantt-color); background: var(--color-paper); padding-left: 0.5rem; }
  .resume-entry[open] > summary .gantt-label, .resume-entry summary:hover .gantt-label { color: var(--gantt-color); }
  .resume-entry[open] .gantt-bar, .resume-entry summary:hover .gantt-bar { opacity: 1; }
  .resume-entry summary:hover .gantt-track, .resume-entry summary:focus-visible .gantt-track { background-color: color-mix(in srgb, var(--gantt-color) 7%, transparent); }
  .resume-detail { position: sticky; left: 0; width: min(100%, 42rem); padding-top: 0.5rem; }
  .disclosure-chevron { flex-shrink: 0; transition: transform 160ms ease-out; }
  details[open] > summary .disclosure-chevron { transform: rotate(180deg); }
  .map-label { paint-order: stroke; stroke: var(--color-paper); stroke-width: 3px; stroke-linejoin: round; }
  .map-marker:focus-visible { outline: none; }
  .map-marker:focus-visible > circle:first-of-type { stroke: var(--color-accent); stroke-width: 2px; stroke-dasharray: 3 3; }
  @media (max-width: 639px) {
    .timeline-grid { grid-template-columns: 150px minmax(0, 1fr); }
    .gantt-label { padding-right: 0.75rem; gap: 0.4rem; }
    .resume-detail { width: calc(100vw - 55px); }
  }
  @media (prefers-reduced-motion: reduce) { .disclosure-chevron { transition: none; } }
  @media print {
    @page { margin: 15mm; }
    html.dark, html { --color-paper: #fff; --color-ink: #161a24; --color-muted: #444; --color-line: #ddd; --color-accent: #161a24; color-scheme: light; }
    body { font-size: 10pt; line-height: 1.4; background: white; color: #161a24; }
    body > header, body > footer, .skip-link, .resume-actions, .resume-map-panel, .timeline-axis, .gantt-track, .disclosure-chevron, .gantt-legend, .resume-explorer > p, astro-dev-toolbar { display: none !important; }
    .gantt-scroll { overflow: visible; }
    .gantt-chart { min-width: 0; }
    .gantt-label, .resume-detail { position: static; width: auto; }
    main { max-width: none !important; padding: 0 !important; }
    .resume-page h1 { font-size: 28pt; }
    .resume-explorer { margin-top: 1rem; }
    .resume-entry { break-inside: avoid; border: 0; }
    .resume-entry summary { padding: 0.5rem 0; display: block; min-height: 0; }
    .resume-detail { padding-bottom: 0.5rem; }
    .resume-detail p { margin-bottom: 0.25rem; }
    .resume-entry::details-content { content-visibility: visible !important; display: block !important; }
    .resume-entry a { text-decoration: none; }
  }
</style>
