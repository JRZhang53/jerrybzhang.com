---
import Base from '../layouts/Base.astro';
import fs from 'node:fs';

// Drop your resume at public/resume.pdf and it will appear here automatically.
const hasPdf = fs.existsSync(new URL('../../public/resume.pdf', import.meta.url));
---

<Base title="Resume" description="Resume of Jerry Zhang.">
  <h1>Resume</h1>
  {hasPdf ? (
    <>
      <p><a href="/resume.pdf">Download PDF</a></p>
      <object data="/resume.pdf" type="application/pdf" class="pdf" aria-label="Resume PDF">
        <p>Your browser can't display the PDF inline. <a href="/resume.pdf">Download it instead.</a></p>
      </object>
    </>
  ) : (
    <p class="muted">Resume coming soon.</p>
  )}
</Base>

<style>
  .pdf {
    width: 100%;
    height: 80vh;
    min-height: 32rem;
    border: 1px solid var(--border);
    border-radius: 8px;
  }
</style>
