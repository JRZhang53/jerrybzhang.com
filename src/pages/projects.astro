---
import Base from '../layouts/Base.astro';
import { PROJECTS, type Project } from '../data/projects';

const projects: readonly Project[] = PROJECTS;
const groups = [
  { id: 'research', heading: 'Research', items: projects.filter((p) => p.kind === 'research') },
  { id: 'course-projects', heading: 'Course projects', items: projects.filter((p) => p.kind === 'course') },
  { id: 'side-projects', heading: 'Side projects', items: projects.filter((p) => p.kind === 'side') },
].filter((g) => g.items.length > 0);
---

<Base title="Projects" description="Research, course projects, and side projects by Jerry Zhang.">
  <h1 class="font-display text-[clamp(2.75rem,7vw,4.5rem)] font-bold tracking-[-0.04em]">Projects</h1>
  {groups.map(({ id, heading, items }) => (
    <section id={id} class="mt-10 scroll-mt-8 sm:mt-12" aria-labelledby={`${id}-heading`}>
      <h2 id={`${id}-heading`} class="mb-3 font-display text-sm font-medium tracking-normal text-muted">{heading}</h2>
      <ol>
        {items.map((p) => <li>
          <details id={p.id} class="project-entry group scroll-mt-8 border-b border-line">
            <summary class="grid cursor-pointer grid-cols-[minmax(0,1fr)_auto_16px] items-baseline gap-x-4 py-5 sm:gap-x-6">
              <h3 class="text-[clamp(1.1rem,2.5vw,1.35rem)] leading-snug transition-colors group-hover:text-accent group-open:text-accent">{p.name}</h3>
              <span class="font-display text-xs text-muted tabular-nums">{p.year}</span>
              <svg class="project-chevron self-center text-muted" width="16" height="16" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m5 8 5 5 5-5" /></svg>
            </summary>
            <div class:list={['grid gap-6 pb-8', p.figure && !p.figure.wide && 'md:grid-cols-[1.15fr_1fr] md:gap-10']}>
              <div class="max-w-[40rem]">
                <p class="text-base leading-relaxed text-pretty text-muted">{p.description}</p>
                {(p.href || p.repo) && <div class="mt-3 flex flex-wrap gap-x-6 font-display text-sm">
                  {p.href && <a class="inline-flex min-h-11 items-center" href={p.href}>{p.kind === 'side' ? 'Explore project' : 'View project'}</a>}
                  {p.repo && <a class="inline-flex min-h-11 items-center" href={p.repo}>View source</a>}
                </div>}
              </div>
              {p.figure && <figure class="min-w-0">
                <a href={p.figure.src} aria-label={`Open full-size figure: ${p.figure.caption}`} class="block rounded-md">
                  <img src={p.figure.src} alt={p.figure.alt} width={p.figure.width} height={p.figure.height} loading="lazy" decoding="async"
                    class="h-auto w-full rounded-md bg-white outline outline-black/10 dark:outline-white/10" />
                </a>
                <figcaption class="mt-3 text-xs leading-relaxed text-muted">{p.figure.caption} <a href={p.figure.source} class="text-muted">Original figure</a></figcaption>
              </figure>}
            </div>
          </details>
        </li>)}
      </ol>
    </section>
  ))}
</Base>

<script>
  // Resume links and shared project URLs open their destination automatically.
  function revealProject() {
    let id: string;
    try { id = decodeURIComponent(window.location.hash.slice(1)); } catch { return; }
    const target = document.getElementById(id);
    if (!(target instanceof HTMLDetailsElement) || !target.classList.contains('project-entry')) return;
    target.open = true;
    requestAnimationFrame(() => target.scrollIntoView({ block: 'start' }));
  }
  revealProject();
  window.addEventListener('hashchange', revealProject);
</script>

<style>
  summary { list-style: none; }
  summary::-webkit-details-marker { display: none; }
  .project-chevron { transition: transform 160ms ease-out; }
  details[open] .project-chevron { transform: rotate(180deg); }
  @media (prefers-reduced-motion: reduce) { .project-chevron { transition: none; } }
</style>
