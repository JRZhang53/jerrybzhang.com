---
import Base from '../layouts/Base.astro';
import { PROJECTS } from '../data/projects';
---

<Base title="Projects" description="Things I've built and worked on.">
  <h1>Projects</h1>
  <p class="muted">Things I've built and worked on.</p>

  <div class="grid">
    {PROJECTS.map((p) => (
      <article class="card">
        <div class="card-head">
          <h2>{p.name}</h2>
          {p.year && <span class="muted year">{p.year}</span>}
        </div>
        <p>{p.description}</p>
        {p.tags && (
          <ul class="tags">
            {p.tags.map((t) => <li>{t}</li>)}
          </ul>
        )}
        {(p.href || p.repo) && (
          <p class="card-links">
            {p.href && <a href={p.href}>Visit</a>}
            {p.repo && <a href={p.repo}>Source</a>}
          </p>
        )}
      </article>
    ))}
  </div>
</Base>

<style>
  .grid {
    display: grid;
    gap: 1rem;
    margin-top: 2rem;
  }
  .card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 1.25rem 1.5rem;
  }
  .card-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }
  .card h2 {
    font-size: 1.3rem;
    margin: 0;
  }
  .year {
    font-size: 0.875rem;
  }
  .card p {
    margin: 0.5rem 0 0;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    padding: 0;
    margin: 0.75rem 0 0;
  }
  .tags li {
    font-size: 0.8rem;
    padding: 0.1rem 0.55rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--muted);
  }
  .card-links {
    display: flex;
    gap: 1rem;
    font-size: 0.95rem;
  }
</style>
