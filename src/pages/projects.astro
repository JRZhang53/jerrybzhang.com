---
import Base from '../layouts/Base.astro';
import { PROJECTS } from '../data/projects';

const groups = [
  { heading: 'Research', note: '', items: PROJECTS.filter((p) => p.kind === 'research') },
  { heading: 'Course projects', note: 'Final projects for Harvard classes.', items: PROJECTS.filter((p) => p.kind === 'course') },
  { heading: 'Side projects', note: 'Small things I made for fun. Each one runs right here on the site.', items: PROJECTS.filter((p) => p.kind === 'side') },
].filter((g) => g.items.length > 0);
---

<Base title="Projects" description="Research, course projects, and side projects by Jerry Zhang.">
  <h1 class="font-display text-[clamp(2.75rem,7vw,4.5rem)] font-bold tracking-[-0.04em]">Projects</h1>

  {groups.map(({ heading, note, items }) => (
    <section class="mt-16">
      <h2 class="text-2xl">{heading}</h2>
      {note && <p class="mt-2 text-base text-muted">{note}</p>}
      <ol class="mt-6 border-t border-line">
        {items.map((p) => (
          <li class="grid gap-x-12 gap-y-2 border-b border-line py-8 md:grid-cols-[11rem_1fr]">
            <span class="font-display text-sm text-muted tabular-nums md:pt-2">{p.year}</span>
            <div class="max-w-[38rem]">
              <h3 class="text-2xl">
                {p.href ? <a href={p.href} class="text-ink no-underline hover:text-accent">{p.name}</a> : p.name}
              </h3>
              <p class="mt-2">{p.description}</p>
              <div class="mt-3 flex flex-wrap items-center gap-x-5 gap-y-2 font-display text-sm">
                {p.tags?.map((t) => <span class="text-muted">{t}</span>)}
                {p.href && <a href={p.href}>{p.kind === 'side' ? 'Try it' : 'Visit'}</a>}
                {p.repo && <a href={p.repo}>View source</a>}
              </div>
            </div>
          </li>
        ))}
      </ol>
    </section>
  ))}
</Base>
