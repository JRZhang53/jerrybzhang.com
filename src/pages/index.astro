---
import Base from '../layouts/Base.astro';
import Hero from '@/components/Hero';
import { SITE, LINKS } from '../data/site';
---

<Base bleed>
  <Hero client:load name={SITE.name} lead={SITE.lead} phrases={SITE.interests} />

  <div class="mx-auto w-full max-w-5xl px-5 sm:px-8">
    <section class="grid gap-x-12 gap-y-4 pt-10 md:grid-cols-[11rem_1fr]">
      <h2 class="text-2xl md:pt-1">About</h2>
      <div class="max-w-[38rem] space-y-5">
        <!-- TODO: add a photo at public/me.jpg and uncomment the line below. -->
        <!-- <img src="/me.jpg" alt="Jerry Zhang" class="size-24 rounded-full object-cover" width="96" height="96" /> -->
        <p>
          I'm a senior studying physics and statistics at Harvard. I'm interested in statistical
          physics, dynamics, and active matter; materials and energy, semiconductors, and photonics;
          and information theory, machine learning, and interpretability.
        </p>
        <p>Outside of class, I play <a href="/pickleball/">pickleball</a>.</p>
        {LINKS.length > 0 && (
          <p class="flex gap-5 font-display text-base">
            {LINKS.map((l) => <a href={l.href}>{l.label}</a>)}
          </p>
        )}
      </div>
    </section>
  </div>
</Base>
