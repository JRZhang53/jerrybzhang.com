---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { SITE, LINKS } from '../data/site';
import { PROJECTS } from '../data/projects';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });
---

<Base>
  <section class="intro">
    <!-- TODO: add a photo at public/me.jpg and uncomment the line below. -->
    <!-- <img src="/me.jpg" alt="Jerry Zhang" class="avatar" width="96" height="96" /> -->
    <h1>Hi, I'm {SITE.name.split(' ')[0]}.</h1>
    <p class="lede">{SITE.tagline}</p>
    <!-- TODO: replace these paragraphs with your own bio. -->
    <p>
      Write two or three sentences about yourself here: what you study or work on, what you're
      curious about right now, and what you're looking for.
    </p>
    <p>
      A second paragraph is a good place for the side projects, interests, or things outside work
      that make you you.
    </p>
    {LINKS.length > 0 && (
      <p class="links">
        {LINKS.map((l) => <a href={l.href}>{l.label}</a>)}
      </p>
    )}
  </section>

  <section>
    <h2>Selected projects</h2>
    <ul class="list">
      {PROJECTS.slice(0, 3).map((p) => (
        <li>
          {p.href ? <a href={p.href}>{p.name}</a> : <span>{p.name}</span>}
          <span class="muted"> · {p.description}</span>
        </li>
      ))}
    </ul>
    <p><a href="/projects/">All projects →</a></p>
  </section>

  {posts.length > 0 && (
    <section>
      <h2>Recent writing</h2>
      <ul class="list">
        {posts.map((post) => (
          <li class="post-row">
            <a href={`/blog/${post.id}/`}>{post.data.title}</a>
            <time class="muted" datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time>
          </li>
        ))}
      </ul>
      <p><a href="/blog/">All posts →</a></p>
    </section>
  )}
</Base>

<style>
  .avatar {
    border-radius: 50%;
    margin-bottom: 1.25rem;
    object-fit: cover;
  }
  .lede {
    font-size: 1.2rem;
    color: var(--muted);
    margin-top: 0;
  }
  .links {
    display: flex;
    gap: 1.25rem;
  }
  .list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .list li {
    padding: 0.4rem 0;
  }
  .post-row {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }
  .post-row time {
    font-size: 0.9rem;
    white-space: nowrap;
  }
</style>
