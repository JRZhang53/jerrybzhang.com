---
import Base from '../layouts/Base.astro';
import Hero from '@/components/Hero';
import { getCollection } from 'astro:content';
import { SITE, LINKS } from '../data/site';
import { PROJECTS } from '../data/projects';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });
---

<Base bleed>
  <Hero client:load name={SITE.name} roles={SITE.roles} />

  <div class="mx-auto w-full max-w-5xl px-5 sm:px-8">
    <section class="grid gap-x-12 gap-y-4 pt-10 md:grid-cols-[11rem_1fr]">
      <h2 class="text-2xl md:pt-1">About</h2>
      <div class="max-w-[38rem] space-y-5">
        <!-- TODO: add a photo at public/me.jpg and uncomment the line below. -->
        <!-- <img src="/me.jpg" alt="Jerry Zhang" class="size-24 rounded-full object-cover" width="96" height="96" /> -->
        <p>
          I study physics and statistics at Harvard (class of 2027). I'm drawn to statistical
          physics and dynamics, materials and energy, and the information-theory and
          interpretability side of machine learning. After graduation I'm joining
          <a href="https://www.hudsonrivertrading.com">Hudson River Trading</a> as an algorithm developer.
        </p>
        <p>
          Along the way I've simulated ion transport in battery electrolytes at NASA Langley, used
          neural networks to study quantum magnets in the Kaxiras group, and interned in quantitative
          research at Citadel Securities. At Harvard I've been a course assistant for physics and
          helped run HackHarvard, including its events abroad.
        </p>
        <p>
          I grew up in Minnesota doing math and physics competitions, and I speak English, Chinese,
          and a little German.
        </p>
        {LINKS.length > 0 && (
          <p class="flex gap-5 font-display text-base">
            {LINKS.map((l) => <a href={l.href}>{l.label}</a>)}
          </p>
        )}
      </div>
    </section>

    <section class="mt-24 grid gap-x-12 gap-y-4 md:grid-cols-[11rem_1fr]">
      <h2 class="text-2xl md:pt-1">Projects</h2>
      <div>
        <ul class="divide-y divide-line border-y border-line">
          {PROJECTS.slice(0, 3).map((p) => (
            <li class="grid grid-cols-[1fr_auto] gap-x-6 py-4">
              {p.href ? (
                <a href={p.href} class="font-display text-xl font-semibold text-ink no-underline hover:text-accent">{p.name}</a>
              ) : (
                <span class="font-display text-xl font-semibold">{p.name}</span>
              )}
              {p.year && <span class="font-display text-sm text-muted tabular-nums">{p.year}</span>}
              <p class="col-span-2 mt-1 text-base text-muted">{p.description}</p>
            </li>
          ))}
        </ul>
        <p class="mt-4 font-display text-base"><a href="/projects/">See all projects</a></p>
      </div>
    </section>

    {posts.length > 0 && (
      <section class="mt-24 grid gap-x-12 gap-y-4 md:grid-cols-[11rem_1fr]">
        <h2 class="text-2xl md:pt-1">Writing</h2>
        <div>
          <ul class="divide-y divide-line border-y border-line">
            {posts.map((post) => (
              <li class="flex items-baseline justify-between gap-6 py-4">
                <a href={`/blog/${post.id}/`} class="font-display text-xl font-semibold text-ink no-underline hover:text-accent">
                  {post.data.title}
                </a>
                <time class="shrink-0 font-display text-sm text-muted tabular-nums" datetime={post.data.date.toISOString()}>
                  {fmt(post.data.date)}
                </time>
              </li>
            ))}
          </ul>
          <p class="mt-4 font-display text-base"><a href="/blog/">Read all posts</a></p>
        </div>
      </section>
    )}
  </div>
</Base>
