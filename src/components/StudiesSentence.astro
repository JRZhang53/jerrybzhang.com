---
interface Props {
  label: string;
  studies: { field: string; detail: string }[];
}
const { label, studies } = Astro.props;
---

<details class="studies">
  <summary class="inline-flex min-h-11 cursor-pointer items-center gap-1 text-ink underline decoration-accent decoration-dotted decoration-2 underline-offset-[5px] hover:decoration-solid">
    {label}
    <svg aria-hidden="true" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-accent">
      <path d="m6 9 6 6 6-6" />
    </svg>
  </summary>
  <dl class="mt-2 divide-y divide-line border-y border-line">
    {studies.map((study) => (
      <div class="grid items-baseline gap-x-6 py-3 sm:grid-cols-[10rem_1fr]">
        <dt class="font-display font-semibold text-ink">{study.field}</dt>
        <dd class="text-base text-muted">{study.detail}</dd>
      </div>
    ))}
  </dl>
</details>

<style>
  summary { list-style: none; }
  summary::-webkit-details-marker { display: none; }
  summary svg { transition: transform 200ms ease-out; }
  details[open] summary svg { transform: rotate(180deg); }
  @media (prefers-reduced-motion: reduce) {
    summary svg { transition: none; }
  }
</style>
