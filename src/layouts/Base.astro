---
import 'katex/dist/katex.min.css';
import '../styles/global.css';
import { SITE, NAV, LINKS } from '../data/site';
import SiteNav from '@/components/SiteNav';
import ThemeToggle from '@/components/ThemeToggle';

interface Props {
  title?: string;
  description?: string;
  /** Let the page start edge to edge (the home hero), instead of inside the column. */
  bleed?: boolean;
}

const { title, description = SITE.description, bleed = false } = Astro.props;
const pageTitle = title ? `${title} | ${SITE.title}` : SITE.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <script is:inline>
      // Apply the saved or system theme before first paint, so there's no flash.
      (() => {
        let theme = null;
        try { theme = localStorage.getItem('theme'); } catch {}
        const dark = theme ? theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.classList.toggle('dark', dark);
        document.documentElement.style.colorScheme = dark ? 'dark' : 'light';
      })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=IBM+Plex+Mono&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="flex min-h-screen flex-col">
    <a href="#main-content" class="skip-link">Skip to content</a>
    <header class="relative z-30 mx-auto flex w-full max-w-5xl items-center justify-between gap-4 px-3 py-4 sm:px-8 sm:py-6">
      <a href="/" class="font-display text-lg font-semibold tracking-tight text-ink no-underline max-sm:sr-only">
        {SITE.name}
      </a>
      <div class="flex items-center gap-1 sm:-mr-3 sm:gap-2">
        <SiteNav client:load items={NAV} pathname={Astro.url.pathname} />
        <ThemeToggle client:load />
      </div>
    </header>

    <main id="main-content" tabindex="-1" class:list={['flex-1', !bleed && 'mx-auto w-full max-w-5xl px-5 pt-14 sm:px-8 sm:pt-20']}>
      <slot />
    </main>

    <footer class="mx-auto mt-28 flex w-full max-w-5xl flex-wrap justify-between gap-x-6 gap-y-2 border-t border-line px-5 pt-6 pb-12 font-display text-sm text-muted sm:px-8">
      <span>© {new Date().getFullYear()} {SITE.name}</span>
      <span class="flex gap-5">
        {LINKS.map((l) => <a class="text-muted no-underline hover:text-ink" href={l.href}>{l.label}</a>)}
      </span>
    </footer>
  </body>
</html>
